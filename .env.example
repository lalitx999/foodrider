# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_SECURE_SSL_REDIRECT=True

# Database
DATABASE_NAME=food_db
DATABASE_USER=food_app
DATABASE_PASSWORD=replace-with-a-database-password
DATABASE_HOST=db
DATABASE_PORT=5432

# Browser access: include the exact HTTPS frontend origin, with no trailing slash.
CORS_ALLOWED_ORIGINS=https://foodrider.example.com
CSRF_TRUSTED_ORIGINS=https://foodrider.example.com

# LINE Messaging API and LIFF
LINE_CHANNEL_ID=replace-with-line-channel-id
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_LIFF_ID_CUSTOMER=replace-with-customer-liff-id
LINE_LIFF_ID_MERCHANT=replace-with-merchant-liff-id
LINE_LIFF_ID_RIDER=replace-with-rider-liff-id
VERCEL_APP_URL=https://foodrider.example.com

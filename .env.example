# Django Core Configuration
DJANGO_SECRET_KEY=django-insecure-super-secret-key-at-least-64-characters-long-security-first-2026-production
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,api.yourdomain.com

# PostgreSQL Database (PostGIS Extension Required)
DATABASE_NAME=food_delivery_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# LINE Messaging API & LIFF Configuration
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_access_token
LINE_LIFF_ID=your_liff_id

# LINE Rich Menu IDs (For Role Switching)
LINE_RICH_MENU_CUSTOMER=richmenu-customer-id
LINE_RICH_MENU_MERCHANT=richmenu-merchant-id
LINE_RICH_MENU_RIDER=richmenu-rider-id

# Google OAuth Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Slip Verification Service
SLIP_VERIFY_API_URL=https://api.slipok.com/api/line/apikey/your_key
SLIP_VERIFY_API_KEY=your_slip_verify_api_key
PLATFORM_PROMPTPAY_ACCOUNT=0810000000

# Platform Business Configuration (Financial & Fare Rates)
DELIVERY_BASE_FARE=20.00
DELIVERY_BASE_DISTANCE_KM=2.00
DELIVERY_PER_KM_FARE=5.00
DEFAULT_GP_RATE=15.00

# Firebase Cloud Messaging (FCM)
FIREBASE_CREDENTIALS_PATH=path/to/firebase_credentials.json

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_SECURE_SSL_REDIRECT=True

# Database
DATABASE_NAME=food_db
DATABASE_USER=food_app
DATABASE_PASSWORD=replace-with-a-database-password
DATABASE_HOST=db
DATABASE_PORT=5432

# Browser access: include the exact HTTPS frontend origin, with no trailing slash.
CORS_ALLOWED_ORIGINS=https://foodrider.example.com
CSRF_TRUSTED_ORIGINS=https://foodrider.example.com

# Authentication, sensitive onboarding data, payments and push
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
BANK_DATA_ENCRYPTION_KEY=replace-with-a-fernet-key
SLIP_VERIFY_API_URL=https://your-slip-provider.example/api/verify
SLIP_VERIFY_API_KEY=replace-with-slip-provider-key
PLATFORM_PROMPTPAY_ACCOUNT=replace-with-platform-promptpay-account
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}

# Slip review workflow (P0-01 / P0-05)
PAYMENT_VERIFICATION_MODE=MANUAL
SLIP_MAX_ATTEMPTS=3
SLIP_MAX_FILE_BYTES=5242880
SLIP_SIGNED_URL_TTL_SECONDS=600
SLIP_REVIEW_SLA_MINUTES=15
# ไฟล์สลิปเก็บนอก MEDIA_ROOT และเสิร์ฟผ่าน X-Accel-Redirect (nginx internal)
SLIP_STORAGE_LOCATION=/app/private_media
USE_X_ACCEL_REDIRECT=True
X_ACCEL_REDIRECT_PREFIX=/private-media/

# Delivery pricing (BR-7 / P0-15): 3 กม.แรก 30 บาท ไรเดอร์ 25 / เกิน กม.ละ 6 บาท ไรเดอร์ 5
DELIVERY_BASE_FARE=30.00
DELIVERY_BASE_DISTANCE_KM=3.00
DELIVERY_PER_KM_FARE=6.00
RIDER_BASE_EARNING=25.00
RIDER_PER_KM_EARNING=5.00
MAX_DELIVERY_DISTANCE_KM=15

# ค้นหาร้าน (P0-12): รัศมีสูงสุดที่ยอมรับจาก query string
MAX_SEARCH_RADIUS_KM=15
DEFAULT_SEARCH_RADIUS_KM=10

# Celery & Redis Task Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

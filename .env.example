# ===== Production (docker-compose.prod.yml) =====
# โดเมนของ API — ต้องชี้ A record มาที่ IP ของ VPS ก่อน Caddy ถึงจะขอ HTTPS ได้
API_DOMAIN=api.example.com
GUNICORN_WORKERS=3
# หลัง Caddy + nginx = 2 proxy (เครื่อง dev ไม่ต้องตั้ง)
DRF_NUM_PROXIES=2
# ร้านเดียว: ปิดสมัครร้าน/ไรเดอร์ (สร้างด้วย manage.py create_branch / create_rider แทน)
MARKETPLACE_SIGNUP_ENABLED=False

# Django
# สร้างด้วย: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_SECURE_SSL_REDIRECT=True

# Database
DATABASE_NAME=food_db
DATABASE_USER=food_app
DATABASE_PASSWORD=replace-with-a-database-password
DATABASE_HOST=db
DATABASE_PORT=5432

# Browser access: include the exact HTTPS frontend origin, with no trailing slash.
CORS_ALLOWED_ORIGINS=https://foodrider.example.com
CSRF_TRUSTED_ORIGINS=https://foodrider.example.com

# Authentication, sensitive onboarding data, payments and push
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
# สร้างด้วย: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_DATA_ENCRYPTION_KEY=replace-with-a-fernet-key
# JSON ทั้งก้อนต้องอยู่บรรทัดเดียว (ดู deploy/README.md)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}

# ===== รับเงิน + ตรวจสลิป (Module 33 · S-4) =====
# พร้อมเพย์ที่ใช้สร้าง QR ให้ลูกค้า: เบอร์ 10 หลัก / เลขประจำตัว 13 หลัก / e-Wallet ID 15 หลัก
# (K PLUS: ตัวเลข "เลขที่อ้างอิง" ใต้ QR รับเงิน)
PLATFORM_PROMPTPAY_ACCOUNT=replace-with-promptpay-id
# บัญชีธนาคารที่รับเงินจริง — ใช้ตรวจว่าสลิปโอนเข้าร้าน (รหัสธนาคาร: 004 = กสิกรไทย)
# ถ้าไม่ตั้งทั้งบัญชีนี้และพร้อมเพย์ ระบบจะไม่อนุมัติสลิปอัตโนมัติเลย (ส่งให้แอดมินตรวจทั้งหมด)
SHOP_BANK_CODE=004
SHOP_BANK_ACCOUNT=replace-with-shop-bank-account
# ชื่อบัญชีรับเงินตามที่ขึ้นในสลิป (คั่นด้วย , ได้ เช่น ชื่อไทย,ชื่ออังกฤษ) — สลิปต้องตรงทั้งชื่อ บัญชี และยอด
SHOP_ACCOUNT_NAMES=replace-with-account-name
# EasySlip API V2 — คีย์จาก https://developer.easyslip.com (ใส่ IP ของ VPS ใน IP whitelist)
SLIP_VERIFY_API_URL=https://api.easyslip.com/v2/verify/bank
SLIP_VERIFY_API_KEY=replace-with-easyslip-key

# Slip review workflow (P0-01 / P0-05)
# MANUAL = แอดมินตรวจทุกใบ · API = ตรวจอัตโนมัติ ไม่ผ่าน = ปฏิเสธ
# HYBRID (แนะนำ) = ผ่าน → ชำระแล้วทันที · ไม่ผ่าน/EasySlip ใช้ไม่ได้ → ส่งให้แอดมินตรวจ
PAYMENT_VERIFICATION_MODE=HYBRID
SLIP_MAX_ATTEMPTS=3
# EasySlip รับรูปไม่เกิน 4MB
SLIP_MAX_FILE_BYTES=4194304
SLIP_SIGNED_URL_TTL_SECONDS=600
SLIP_REVIEW_SLA_MINUTES=15
# ไฟล์สลิปเก็บนอก MEDIA_ROOT และเสิร์ฟผ่าน X-Accel-Redirect (nginx internal)
SLIP_STORAGE_LOCATION=/app/private_media
USE_X_ACCEL_REDIRECT=True
X_ACCEL_REDIRECT_PREFIX=/private-media/

# Delivery pricing (BR-7 / P0-15): 3 กม.แรก 30 บาท ไรเดอร์ 25 / เกิน กม.ละ 6 บาท ไรเดอร์ 5
DELIVERY_BASE_FARE=30.00
DELIVERY_BASE_DISTANCE_KM=3.00
DELIVERY_PER_KM_FARE=6.00
RIDER_BASE_EARNING=25.00
RIDER_PER_KM_EARNING=5.00
MAX_DELIVERY_DISTANCE_KM=15

# ค้นหาร้าน (P0-12): รัศมีสูงสุดที่ยอมรับจาก query string
MAX_SEARCH_RADIUS_KM=15
DEFAULT_SEARCH_RADIUS_KM=10

# Celery & Redis (docker-compose.prod.yml ตั้งค่าเหล่านี้ให้เองแล้ว — ใช้กับเครื่อง dev)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# พิกัดไรเดอร์สด + throttle ใช้ cache นี้ (เว้นว่าง = LocMem เฉพาะ dev)
REDIS_CACHE_URL=redis://redis:6379/1

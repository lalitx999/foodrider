# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_SECURE_SSL_REDIRECT=True

# Database
DATABASE_NAME=food_db
DATABASE_USER=food_app
DATABASE_PASSWORD=replace-with-a-database-password
DATABASE_HOST=db
DATABASE_PORT=5432

# Browser access: include the exact HTTPS frontend origin, with no trailing slash.
CORS_ALLOWED_ORIGINS=https://foodrider.example.com
CSRF_TRUSTED_ORIGINS=https://foodrider.example.com

# Authentication, sensitive onboarding data, payments and push
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
BANK_DATA_ENCRYPTION_KEY=replace-with-a-fernet-key
SLIP_VERIFY_API_URL=https://your-slip-provider.example/api/verify
SLIP_VERIFY_API_KEY=replace-with-slip-provider-key
PLATFORM_PROMPTPAY_ACCOUNT=replace-with-platform-promptpay-account
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}

# Delivery pricing
DELIVERY_BASE_FARE=20.00
DELIVERY_BASE_DISTANCE_KM=2.00
DELIVERY_PER_KM_FARE=5.00
